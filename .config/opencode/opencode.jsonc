{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "share": "manual",
  "autoupdate": "notify",
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 30000
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow"
    },
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}